{
  "name": "@clausekit/sdk",
  "version": "0.1.0",
  "description": "ClauseKit EU AI Act Article 50 compliance SDK for LLM and binary outputs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\\\n')\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "test-run": "npm run build && node dist/cjs/examples/test-run.js"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
